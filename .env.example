APP_NAME=Unity
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://unity.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unity
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Admin SDK — service account JSON path or raw JSON. Used server-side
# only to verify Phone Auth ID tokens issued by the Flutter app's Firebase SDK.
FIREBASE_PROJECT=app
FIREBASE_CREDENTIALS=

# Firebase Web SDK — public client-side config for website phone/OTP login
# (from the "Unity Website" web app registered in the same Firebase project).
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=

# Payment gateway (PhonePe). Fallback only — real credentials are managed
# via the admin panel's PhonePe Settings page, which takes precedence.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=

# SMS gateway (MSG91) — DLT template IDs required for India transactional SMS.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# Firebase Cloud Messaging project id (push notifications).
FCM_PROJECT_ID=

# Store links used by the public website's download CTAs and /r/{code} referral landing page.
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=in.unityapp
APP_STORE_URL=https://apps.apple.com/app/unity/id0000000000
